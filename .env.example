# --- PostgreSQL データベース ---
POSTGRES_DB=attendance_bot
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=bot_password

# --- Discord Bot トークン ---
DOOR_BOT_TOKEN=your_door_bot_token_here
ATTENDANCE_BOT_TOKEN=your_attendance_bot_token_here
UTILS_BOT_TOKEN=your_utils_bot_token_here

# --- 各種設定 ---
DOOR_BOT_CHANNELS=123456789012345678,987654321098765432
