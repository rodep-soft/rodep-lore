# ドア上部距離センサにつながっているArduino用のudev rule
# これが/etc/udev/rules.dに配置されていないと正しくbotが機能しない

# Arduino Uno R4 Minima (実行モード)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0069", MODE="0666", GROUP="plugdev", SYMLINK+="doorduino"

# Arduino Uno R4 Minima (書き込みモード/DFU)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0369", MODE="0666", GROUP="plugdev", SYMLINK+="doorduino"
